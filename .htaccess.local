# ==================================================
# Local Development (.htaccess.local)
# ==================================================

Options -Indexes
ServerSignature Off

RewriteEngine On

# ==================================================
# Pretty URLs
# ==================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about/?$ about.php [L]

# ==================================================
# Error Pages
# ==================================================

ErrorDocument 404 /custom-web-development/404.php
ErrorDocument 403 /custom-web-development/403.php

# ==================================================
# Protect Sensitive Files
# ==================================================

<FilesMatch "^(\.env|\.htaccess|composer\.json|composer\.lock|phpunit\.xml|README\.md)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 /\..*$

# ==================================================
# Security Headers
# ==================================================

<IfModule mod_headers.c>

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

</IfModule>

# ==================================================
# Browser Cache
# ==================================================

<IfModule mod_expires.c>

ExpiresActive On

ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"

ExpiresDefault "access plus 7 days"

</IfModule>

